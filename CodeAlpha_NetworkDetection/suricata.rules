alert tcp any any -> $HOME_NET 23 (msg:"NIDS suspicious Telnet service access"; flags:S; priority:1; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET 445 (msg:"NIDS suspicious SMB service access"; flags:S; priority:1; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 3389 (msg:"NIDS suspicious RDP service access"; flags:S; priority:1; sid:1000003; rev:1;)
alert tcp any any -> $HOME_NET 4444 (msg:"NIDS suspicious high-risk service access"; flags:S; priority:1; sid:1000004; rev:1;)
